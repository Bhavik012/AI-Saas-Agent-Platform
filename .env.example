# ==========================================
# Meet.AI Environment Configuration
# ==========================================
# Copy this file to .env and configure with your credentials.
# NEVER commit .env to version control.

# Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/meetai?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="generate-a-secure-random-32-character-secret-key"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Social Authentication (OAuth)
# GitHub OAuth App: https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Google Cloud OAuth: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Stream Video SDK: https://getstream.io/video/
NEXT_PUBLIC_STREAM_VIDEO_API_KEY="your_stream_video_api_key"
STREAM_VIDEO_SECRET_KEY="your_stream_video_secret_key"

# LiveKit WebRTC Voice Agent: https://livekit.io/
# Client-side WebRTC connection
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
# Background agent worker connection
LIVEKIT_WS_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"
DEMO_ROOM="demo"

# Google Gemini AI: https://aistudio.google.com/
GEMINI_API_KEY="your_google_gemini_api_key"
GOOGLE_API_KEY="your_google_gemini_api_key"
GEMINI_REALTIME_MODEL="gemini-2.5-flash-live"
